# Homebrew cask template for FoxxyCode.
#
# Not installable as it stands: scripts/build-homebrew-cask.sh fills the version
# and the two checksums from the macOS archives of a release and writes the
# result to dist/foxxycode.rb. Run `make brew VERSION=X.Y.Z`.
#
# The cask takes the same darwin archives `foxxycode update` takes, so a brew
# install and a manual one are the same binary. The archives carry the man page
# and the shell completions beside it, which is what the artifacts below link.
#
# The `zap` stanza names ~/.foxxycode - sessions, skills, credentials and the
# config. Only `brew zap` removes it; `brew uninstall` leaves it alone.
#
# Everything above the `cask` line is stripped when the file is rendered, so the
# published cask stays comment-free the way homebrew/cask expects.

cask "foxxycode" do
  arch arm: "arm64", intel: "amd64"

  version "__VERSION__"
  sha256 arm:   "__SHA256_ARM64__",
         intel: "__SHA256_AMD64__"

  url "https://github.com/hijera/foxxy-agent/releases/download/#{version}/foxxycode_#{version}_darwin_#{arch}.tar.gz",
      verified: "github.com/hijera/foxxy-agent/"
  name "FoxxyCode Agent"
  desc "Coding agent with a console, an editor protocol and an HTTP gateway"
  homepage "https://github.com/hijera/foxxy-agent"

  livecheck do
    url :url
    strategy :github_latest
  end

  binary "foxxycode"
  manpage "foxxycode.1"
  binary "foxxycode.bash", target: "#{HOMEBREW_PREFIX}/etc/bash_completion.d/foxxycode"
  binary "foxxycode.zsh",  target: "#{HOMEBREW_PREFIX}/share/zsh/site-functions/_foxxycode"

  zap trash: "~/.foxxycode"
end
