<idea-plugin>
    <id>dev.foxxycode.intellij</id>
    <name>FoxxyCode</name>
    <vendor email="hebopine981@gmail.com">FoxxyCode</vendor>

    <description><![CDATA[
        <p>Run the full <b>FoxxyCode</b> agent inside any JetBrains IDE (IntelliJ IDEA, PhpStorm,
        WebStorm, PyCharm, GoLand, etc.).</p>
        <p>The plugin launches the <code>foxxycode http</code> process scoped to the current project
        and embeds the complete FoxxyCode web UI in a tool window via JCEF: chat, sessions/history,
        scheduler, settings (API keys), skills browser, plan mode, model &amp; reasoning selection,
        and memory.</p>
        <p>The <code>foxxycode</code> binary is built from source and bundled with the plugin — no
        download step. You can point the plugin at a custom <code>foxxycode</code> binary in
        Settings | Tools | FoxxyCode.</p>
    ]]></description>

    <!-- Platform-only dependency: installs in every IntelliJ-based IDE. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.foxxycode.intellij.settings.FoxxyCodeSettings"/>
        <projectService serviceImplementation="dev.foxxycode.intellij.process.FoxxyCodeProcessManager"/>
        <projectService serviceImplementation="dev.foxxycode.intellij.diff.FoxxyCodeIdeDiffService"/>
        <projectService serviceImplementation="dev.foxxycode.intellij.editor.FoxxyCodeEditorContextService"/>
        <projectService serviceImplementation="dev.foxxycode.intellij.terminal.FoxxyCodeTerminalContextService"/>
        <projectService serviceImplementation="dev.foxxycode.intellij.autocomplete.FoxxyCodeAutocompleteService"/>

        <!-- Inline code autocomplete. The listener only asks the backend once
             config.autocomplete enables it (Settings form, Autocomplete tab); Tab and Escape are
             wrapped rather than rebound, so both keep their normal behaviour with no suggestion
             on screen. -->
        <editorFactoryDocumentListener
                implementation="dev.foxxycode.intellij.autocomplete.AutocompleteDocumentListener"/>
        <editorActionHandler action="EditorTab"
                             implementationClass="dev.foxxycode.intellij.autocomplete.AcceptSuggestionHandler"
                             id="foxxycodeAcceptSuggestion" order="first"/>
        <editorActionHandler action="EditorEscape"
                             implementationClass="dev.foxxycode.intellij.autocomplete.DismissSuggestionHandler"
                             id="foxxycodeDismissSuggestion" order="first"/>

        <applicationConfigurable
                parentId="tools"
                id="dev.foxxycode.intellij.settings.FoxxyCodeConfigurable"
                displayName="FoxxyCode"
                instance="dev.foxxycode.intellij.settings.FoxxyCodeConfigurable"/>

        <toolWindow
                id="FoxxyCode"
                anchor="right"
                icon="/icons/foxxycodeToolWindow.svg"
                factoryClass="dev.foxxycode.intellij.ui.FoxxyCodeToolWindowFactory"/>

        <notificationGroup id="FoxxyCode" displayType="BALLOON"/>
    </extensions>

    <!-- The backend must be dead before the IDE exits or the plugin is replaced: on Windows a
         surviving process keeps its port, and anything it still has open cannot be deleted. -->
    <applicationListeners>
        <listener class="dev.foxxycode.intellij.process.FoxxyCodeBackendLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="dev.foxxycode.intellij.process.FoxxyCodeBackendLifecycleListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="FoxxyCodeWelcome"
                class="dev.foxxycode.intellij.ui.FoxxyCodeWelcomeAction"
                text="Show FoxxyCode Welcome"
                description="Re-open the FoxxyCode onboarding tour">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="FoxxyCodeTriggerSuggestion"
                class="dev.foxxycode.intellij.autocomplete.TriggerSuggestionAction"
                text="Suggest Code at Caret"
                description="Ask FoxxyCode for an inline code suggestion at the caret">
            <keyboard-shortcut first-keystroke="alt BACK_SLASH" keymap="$default"/>
        </action>
        <action id="FoxxyCodeAddFile"
                class="dev.foxxycode.intellij.ui.FoxxyCodeAddFileAction"
                text="Add to FoxxyCode"
                description="Insert the file into the FoxxyCode composer as an @-mention">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
