{
  "name": "foxxycode-site",
  "version": "1.0.0",
  "private": true,
  "description": "The FoxxyCode website on GitHub Pages: landing, compare and changelog pages in English and Russian.",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "data:offline": "node scripts/build-data.mjs --offline test/fixtures/releases.json --strict",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assemble": "node scripts/assemble.mjs --docs ../docs --dist dist --out _site"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^3.2.4"
  }
}
